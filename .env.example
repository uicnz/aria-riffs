# Aria Environment Variables
# Copy to .env and set secrets. Shell env vars take precedence over this file.

# Anthropic (runtime-enabled)
ANTHROPIC_API_KEY=

# OpenAI (runtime-enabled)
OPENAI_API_KEY=

# Google Gemini (runtime-enabled)
GOOGLE_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=   # Optional alias

# Aria Gateway (powered by Vercel, runtime-enabled)
ARIA_GATEWAY_API_KEY=
# AI_GATEWAY_API_KEY=             # Vercel canonical alias (accepted)
# VERCEL_API_KEY=                 # Legacy alias (accepted)
VERCEL_MODEL=openai/gpt-5-mini

# ElevenLabs (future provider)
ELEVENLABS_API_KEY=
