{
    "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "complexity": {
                "noUselessConstructor": "error",
                "noUselessEmptyExport": "error",
                "useFlatMap": "error",
                "useLiteralKeys": "off"
            },
            "correctness": {
                "noUnusedVariables": {
                    "level": "error",
                    "options": {
                        "ignoreRestSiblings": true
                    }
                },
                "noConstAssign": "error",
                "noInnerDeclarations": "warn"
            },
            "style": {
                "useConst": "error",
                "noNonNullAssertion": "warn"
            },
            "suspicious": {
                "noExplicitAny": "warn",
                "noVar": "error",
                "noConsole": "off",
                "noArrayIndexKey": "off"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "formatWithErrors": false,
        "indentStyle": "tab",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "es5",
            "semicolons": "always",
            "arrowParentheses": "asNeeded",
            "bracketSpacing": true,
            "bracketSameLine": false,
            "quoteProperties": "preserve"
        }
    },
    "json": {
        "formatter": {
            "enabled": true,
            "indentStyle": "space",
            "indentWidth": 4,
            "lineWidth": 120,
            "trailingCommas": "none"
        }
    },
    "files": {
        "ignoreUnknown": true,
        "maxSize": 300000,
        "includes": [
            "**/*.ts",
            "**/*.tsx",
            "**/*.jsx",
            "!**/*.min.js",
            "!**/*.js",
            "!**/*.mjs",
            "!**/*.cjs",
            "!riffs/doc-indexer/src/viewer/libs"
        ]
    },
    "overrides": [
        {
            "includes": ["test/**/*.ts", "**/*.test.ts"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    },
                    "style": {
                        "noNonNullAssertion": "off"
                    }
                }
            }
        }
    ]
}
