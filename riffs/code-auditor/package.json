{
    "name": "@aria/code-auditor",
    "version": "0.2.0",
    "description": "Dependency management and security scanning",
    "type": "module",
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=26.0.0"
    },
    "main": "dist/cli.js",
    "bin": {
        "code-auditor": "dist/cli.js"
    },
    "files": [
        "dist/",
        "src/",
        "config.yaml"
    ],
    "scripts": {
        "start": "bun src/cli.ts",
        "audit": "bun src/cli.ts audit",
        "audit:json": "bun src/cli.ts audit --json",
        "update": "bun src/cli.ts update",
        "update:dry": "bun src/cli.ts update --dry-run",
        "update:selective": "bun src/cli.ts update --selective",
        "update:dev": "bun src/cli.ts update --dev-only",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run --coverage --coverage.reportsDirectory=../../coverage/code-auditor --coverage.include='**/*.ts' test/"
    },
    "dependencies": {
        "commander": "^15.0.0",
        "dotenv": "^18.0.0",
        "pino": "^10.3.1",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    }
}
