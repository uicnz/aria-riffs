{
    "name": "@aria/image-renamer",
    "version": "0.2.0",
    "description": "Batch image renaming with AI-generated filenames",
    "type": "module",
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=26.0.0"
    },
    "main": "dist/cli.js",
    "bin": {
        "image-renamer": "dist/cli.js"
    },
    "files": [
        "dist/",
        "src/",
        "config.yaml"
    ],
    "scripts": {
        "build": "bun ../../scripts/build-riff.ts",
        "start": "bun src/cli.ts",
        "rename": "bun src/cli.ts rename",
        "rename:dry": "bun src/cli.ts rename --dry-run",
        "watch": "bun src/cli.ts watch",
        "check": "bun src/cli.ts check-connection",
        "models": "bun src/cli.ts list-models",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run --coverage --coverage.reportsDirectory=../../coverage/image-renamer --coverage.include='**/*.ts' test/",
        "test:setup": "bun test/create-fixtures.ts"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.57",
        "@ai-sdk/google": "^4.0.75",
        "ai": "^7.0.106",
        "ai-sdk-ollama": "^4.3.0",
        "cli-progress": "^3.12.0",
        "commander": "^15.0.0",
        "dotenv": "^18.0.0",
        "fs-extra": "^11.4.0",
        "libsql": "^0.5.29",
        "ollama": "^0.6.3",
        "pino": "^10.3.1",
        "sharp": "^0.35.4",
        "watcher": "^2.3.1",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    }
}
