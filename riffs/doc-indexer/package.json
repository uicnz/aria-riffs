{
    "name": "@aria/doc-indexer",
    "version": "0.2.0",
    "description": "Document indexing, semantic search, and knowledge graphs",
    "type": "module",
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=26.0.0"
    },
    "main": "dist/cli.js",
    "bin": {
        "doc-indexer": "dist/cli.js"
    },
    "files": [
        "dist/",
        "src/",
        "config.yaml"
    ],
    "scripts": {
        "build": "bun ../../scripts/build-riff.ts",
        "start": "bun src/cli.ts",
        "index": "bun src/cli.ts index",
        "index:reset": "bun src/cli.ts index --reset",
        "search": "bun src/cli.ts search",
        "graph": "bun src/cli.ts graph",
        "graph:content": "bun src/cli.ts graph --include-content",
        "graph:html": "bun src/cli.ts graph:html",
        "graph:validate": "bun src/cli.ts graph:validate",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run --coverage --coverage.reportsDirectory=../../coverage/doc-indexer --coverage.include='**/*.ts' test/"
    },
    "dependencies": {
        "commander": "^15.0.0",
        "dotenv": "^18.0.0",
        "glob": "^13.0.6",
        "libsql": "^0.5.29",
        "openai": "^7.18.0",
        "pino": "^10.3.1",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    }
}
