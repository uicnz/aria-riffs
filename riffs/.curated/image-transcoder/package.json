{
    "name": "@aria/image-transcoder",
    "version": "0.2.0",
    "description": "Image resize and format conversion",
    "type": "module",
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=26.0.0"
    },
    "main": "dist/cli.js",
    "bin": {
        "image-transcoder": "dist/cli.js"
    },
    "files": [
        "dist/",
        "src/",
        "config.yaml",
        "README.md",
        "RIFF.md",
        "aria.yaml"
    ],
    "scripts": {
        "build": "bun ../../../scripts/build-riff.ts",
        "start": "bun src/cli.ts",
        "process": "bun src/cli.ts process",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run --coverage --coverage.reportsDirectory=../../coverage/image-transcoder --coverage.include='**/*.ts' test/",
        "lint": "biome lint .",
        "check": "bun run test && bun run typecheck && bun run lint"
    },
    "dependencies": {
        "commander": "^15.0.0",
        "dotenv": "^18.0.0",
        "pino": "^10.3.1",
        "sharp": "^0.35.4",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    }
}
