{
    "name": "@aria/prompt-tracer",
    "version": "0.2.0",
    "description": "Anthropic coding CLI prompt extraction and analysis",
    "type": "module",
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=26.0.0"
    },
    "main": "dist/cli.js",
    "bin": {
        "prompt-tracer": "dist/cli.js"
    },
    "files": [
        "dist/",
        "src/",
        "config.yaml",
        "README.md",
        "RIFF.md"
    ],
    "scripts": {
        "build": "bun ../../../scripts/build-riff.ts",
        "start": "bun src/cli.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run --coverage --coverage.reportsDirectory=../../coverage/prompt-tracer --coverage.include='**/*.ts' test/"
    },
    "dependencies": {
        "commander": "^15.0.0",
        "dotenv": "^18.0.0",
        "js-yaml": "^5.4.2",
        "pino": "^10.3.1",
        "shell-quote": "^1.10.0",
        "zod": "^4.6.5"
    }
}
