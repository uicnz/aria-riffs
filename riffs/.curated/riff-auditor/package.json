{
    "name": "@aria/riff-auditor",
    "version": "0.2.0",
    "description": "Riff configuration auditing and validation",
    "type": "module",
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=26.0.0"
    },
    "main": "dist/cli.js",
    "bin": {
        "riff-auditor": "dist/cli.js"
    },
    "files": [
        "dist/",
        "src/",
        "config.yaml",
        "README.md",
        "RIFF.md"
    ],
    "scripts": {
        "build": "bun ../../../scripts/build-riff.ts",
        "start": "bun src/cli.ts",
        "audit": "bun src/cli.ts audit",
        "check": "bun src/cli.ts check",
        "list": "bun src/cli.ts list",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run --coverage --coverage.reportsDirectory=../../coverage/riff-auditor --coverage.include='**/*.ts' test/"
    },
    "dependencies": {
        "commander": "^15.0.0",
        "dotenv": "^18.0.0",
        "js-yaml": "^5.4.2",
        "pino": "^10.3.1",
        "typescript": "^7.0.2",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    }
}
