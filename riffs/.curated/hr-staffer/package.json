{
    "name": "@aria/hr-staffer",
    "version": "0.2.0",
    "description": "Staff directory with semantic matching",
    "type": "module",
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=26.0.0"
    },
    "main": "dist/cli.js",
    "bin": {
        "hr-staffer": "dist/cli.js"
    },
    "files": [
        "dist/",
        "src/",
        "config.yaml",
        "README.md",
        "RIFF.md"
    ],
    "scripts": {
        "build": "bun ../../../scripts/build-riff.ts",
        "start": "bun src/cli.ts",
        "decompose": "bun src/cli.ts decompose",
        "index": "bun src/cli.ts index",
        "search": "bun src/cli.ts search",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run --coverage --coverage.reportsDirectory=../../coverage/hr-staffer --coverage.include='**/*.ts' test/"
    },
    "dependencies": {
        "@ai-sdk/google": "^4.0.75",
        "@ai-sdk/openai": "^4.0.70",
        "ai": "^7.0.106",
        "ai-sdk-ollama": "^4.3.0",
        "commander": "^15.0.0",
        "dotenv": "^18.0.0",
        "js-yaml": "^5.4.2",
        "libsql": "^0.5.29",
        "pino": "^10.3.1",
        "zod": "^4.6.5"
    }
}
