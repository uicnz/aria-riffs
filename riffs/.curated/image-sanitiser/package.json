{
    "name": "@aria/image-sanitiser",
    "version": "0.2.0",
    "description": "Image file extension verification and correction",
    "type": "module",
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=26.0.0"
    },
    "main": "dist/cli.js",
    "bin": {
        "image-sanitiser": "dist/cli.js"
    },
    "files": [
        "dist/",
        "src/",
        "config.yaml",
        "README.md",
        "RIFF.md"
    ],
    "scripts": {
        "build": "bun ../../../scripts/build-riff.ts",
        "start": "bun src/cli.ts",
        "sanitise": "bun src/cli.ts sanitise",
        "sanitise:dry": "bun src/cli.ts sanitise --dry-run",
        "analyse": "bun src/cli.ts analyse",
        "detect": "bun src/cli.ts detect",
        "check": "bun src/cli.ts check-deps",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run --coverage --coverage.reportsDirectory=../../coverage/image-sanitiser --coverage.include='**/*.ts' test/"
    },
    "dependencies": {
        "cli-progress": "^3.12.0",
        "commander": "^15.0.0",
        "dotenv": "^18.0.0",
        "file-type": "^22.1.1",
        "fs-extra": "^11.4.0",
        "libsql": "^0.5.29",
        "pino": "^10.3.1",
        "sharp": "^0.35.4",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    }
}
