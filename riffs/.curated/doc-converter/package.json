{
    "name": "@aria/doc-converter",
    "version": "0.2.0",
    "description": "DocX to Markdown conversion with 18 Aria Rules",
    "type": "module",
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=26.0.0"
    },
    "main": "dist/cli.js",
    "bin": {
        "doc-converter": "dist/cli.js"
    },
    "files": [
        "dist/",
        "src/",
        "config.yaml",
        "README.md",
        "RIFF.md"
    ],
    "scripts": {
        "build": "bun ../../../scripts/build-riff.ts",
        "start": "bun src/cli.ts",
        "config": "bun src/lib/generate-config.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run --coverage --coverage.reportsDirectory=../../coverage/doc-converter --coverage.include='**/*.ts' test/"
    },
    "dependencies": {
        "cheerio": "^1.2.0",
        "commander": "^15.0.0",
        "dotenv": "^18.0.0",
        "markdownlint": "^0.41.1",
        "pino": "^10.3.1",
        "turndown": "^7.2.4",
        "turndown-plugin-gfm": "^1.0.2",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    }
}
