{
  "name": "aria-riffs",
  "version": "0.2.0",
  "description": "Aria riffs workspace.",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "riffs/*"
  ],
  "overrides": {
    "smol-toml": "1.8.0"
  },
  "scripts": {
    "test": "vitest run --coverage --coverage.reportsDirectory=coverage",
    "test:ui": "vitest --ui",
    "test:setup": "bun riffs/image-renamer/test/create-fixtures.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
